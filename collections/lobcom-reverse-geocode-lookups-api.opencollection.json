{
  "opencollection": "1.0.0",
  "info": {
    "name": "Lob Reverse Geocode Lookups API",
    "version": "1.22.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Reverse Geocode Lookups",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Reverse Geocode Lookup",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.lob.com/v1/us_reverse_geocode_lookups",
            "params": [
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "Determines the number of locations returned. Possible values are between 1 and 50 and any number higher will be rounded down to 50. Default size is a list of 5 reverse geocoded locations."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Reverse geocode a valid US location with a live API key."
        }
      ]
    }
  ],
  "bundled": true
}